<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" 
            xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="edu.utj.dsm.poo.hotel.controlador.AdministradorController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <left>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Gestión de Administradores" />
            
            <GridPane hgap="10.0" vgap="8.0">
               <children>
                  <Label text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <TextField fx:id="txtId" editable="false" promptText="Autogenerado" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <TextField fx:id="txtTelefono" promptText="10 dígitos" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <TextField fx:id="txtEmail" promptText="correo@ejemplo.com" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <TextField fx:id="txtDireccion" promptText="Calle, número, col." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  
                  <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <TextField fx:id="txtUsuario" promptText="Nombre de usuario" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  
                  <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                  <TextField fx:id="txtClaveAcceso" promptText="Clave de acceso" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                  
                  <Label text="Rol:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                  <ComboBox fx:id="cmbRol" prefWidth="175.0" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  
                  <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                  <ComboBox fx:id="cmbEstado" prefWidth="175.0" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                  
                  <Label text="Foto Perfil:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
                  <HBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="9">
                     <children>
                        <TextField fx:id="txtRutaImagen" editable="false" promptText="Ruta de la imagen" HBox.hgrow="ALWAYS" />
                        <Button onAction="#btnSeleccionarImagenOnAction" text="..." />
                     </children>
                  </HBox>
               </children>
            </GridPane>
            
            <!-- Vista previa de imagen -->
            <VBox alignment="CENTER" prefHeight="120.0" prefWidth="260.0" style="-fx-border-color: #ccc; -fx-border-radius: 5;">
               <children>
                  <ImageView fx:id="imgVistaPrevia" fitHeight="110.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </VBox>
            
            <!-- Botones de Acción CRUD -->
            <HBox spacing="8.0">
               <children>
                  <Button fx:id="btnGuardar" onAction="#btnGuardarOnAction" text="Guardar" />
                  <Button fx:id="btnActualizar" onAction="#btnActualizarOnAction" text="Actualizar" />
                  <Button fx:id="btnEliminar" onAction="#btnEliminarOnAction" text="Eliminar" />
                  <Button fx:id="btnLimpiar" onAction="#btnLimpiarOnAction" text="Limpiar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets left="15.0" />
         </BorderPane.margin>
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Catálogo de Administradores registrados" />
            <TableView fx:id="tblAdministradores" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
                  <TableColumn fx:id="colNombre" prefWidth="148.0" text="Nombre" />
                  <TableColumn fx:id="colEmail" prefWidth="130.0" text="Email" />
                  <TableColumn fx:id="colUsuario" prefWidth="90.0" text="Usuario" />
                  <TableColumn fx:id="colRol" prefWidth="110.0" text="Rol" />
                  <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado" />
                  <TableColumn fx:id="colRutaImagen" prefWidth="150.0" text="Ruta Imagen" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>